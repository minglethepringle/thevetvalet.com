---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import { nav, contact, social, url } from '../data/site';

// Brand marks (Facebook and Yelp from Simple Icons, CC0; Instagram drawn as a simple glyph).
const brandPaths = {
  instagram:
    'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2zM7.8 4A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4zM12 7.2a4.8 4.8 0 1 1 0 9.6a4.8 4.8 0 1 1 0-9.6zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6zM17.4 5.4a1.2 1.2 0 1 1 0 2.4a1.2 1.2 0 1 1 0-2.4z',
  facebook:
    'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  yelp: 'M20.16 12.594l-4.995 1.433c-.96.276-1.74-.8-1.176-1.63l2.905-4.308a1.072 1.072 0 0 1 1.596-.206 9.194 9.194 0 0 1 2.364 3.252 1.073 1.073 0 0 1-.686 1.459zm-5.025 3.152l4.942 1.606a1.072 1.072 0 0 1 .636 1.48 9.316 9.316 0 0 1-2.47 3.169 1.073 1.073 0 0 1-1.592-.26l-2.76-4.409c-.528-.847.288-1.894 1.236-1.584zm-4.796-4.368L5.454 2.916a1.072 1.072 0 0 1 .466-1.5A14.973 14.973 0 0 1 11.184.003a1.07 1.07 0 0 1 1.153 1.068v9.768c0 1.096-1.45 1.483-1.998.535zm-.857 4.17l-4.982 1.627a1.072 1.072 0 0 1-1.379-.861 9.11 9.11 0 0 1 .396-3.989 1.072 1.072 0 0 1 1.465-.637l4.766 2.014c.931.393.868 1.73-.266 1.846zM11.2 17.56l-.18 5.24a1.072 1.072 0 0 1-1.268 1.026 9.26 9.26 0 0 1-3.746-1.495 1.072 1.072 0 0 1-.203-1.594l3.4-4.034c.656-.778 1.948-.317 1.997.857z',
};

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <div class="logo-chip">
        <Image src={logo} alt="Vet Valet" width={150} />
      </div>
      <p>Compassionate, in-home veterinary care for the pets of MetroWest Boston.</p>
      <ul class="social">
        {social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={`Vet Valet on ${s.name}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={brandPaths[s.icon]} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Explore</h2>
      <ul class="footer-links">
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Get in touch</h2>
      <ul class="footer-contact">
        <li><Icon name="text" /><span>Text <a href={contact.textHref}>{contact.textDisplay}</a></span></li>
        <li><Icon name="mail" /><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Hours</h2>
      <ul class="footer-contact">
        {contact.hours.map(([days, time]) => (
          <li><Icon name="clock" /><span>{days}<br /><strong>{time}</strong></span></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} Vet Valet. All rights reserved. · Designed by <a href="https://mingletechsolutions.com/" target="_blank" rel="noopener">Mingle Tech Solutions</a></span>
    <span>For life-threatening emergencies, go to your nearest emergency veterinary hospital.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: rgb(255 255 255 / 0.78);
    padding-top: clamp(56px, 7vw, 80px);
    font-size: 0.9688rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.1fr 1.1fr;
    gap: 2.5rem;
  }
  .logo-chip {
    display: inline-block;
    padding: 14px 18px;
    border-radius: 16px;
    background: var(--white);
    margin-bottom: 1.25rem;
  }
  .logo-chip img {
    width: 120px;
  }
  .footer-brand p {
    max-width: 22em;
  }
  .social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .social a:hover {
    background: var(--sky);
    color: var(--navy-deep);
  }
  .social svg {
    display: block;
    width: 18px;
    height: 18px;
  }
  .footer-title {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sky);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links li + li {
    margin-top: 0.5rem;
  }
  a {
    color: var(--white);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-contact li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .footer-contact li + li {
    margin-top: 0.75rem;
  }
  .footer-contact :global(svg) {
    width: 18px;
    height: 18px;
    margin-top: 0.2em;
    flex: none;
    color: var(--sky);
  }
  .footer-contact strong {
    color: var(--white);
    font-weight: 600;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(48px, 6vw, 72px);
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.8438rem;
    color: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
