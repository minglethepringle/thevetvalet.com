---
import { business, url } from '../data/site';
import { absolute, breadcrumbNode, businessNode, webPageNode, websiteNode } from '../data/schema';
import logo from '../assets/logo.png';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Full <title>, e.g. from pageMeta in src/data/site.ts. */
  title: string;
  description?: string;
  /** Extra properties for this page's WebPage node, e.g. { '@type': 'FAQPage', mainEntity: [...] }. */
  page?: Record<string, unknown>;
  /** Extra JSON-LD nodes for this page's @graph. */
  graph?: Record<string, unknown>[];
}
const { title, description = business.summary, page = {}, graph = [] } = Astro.props;

const site = Astro.site!;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(basePath.length) || '/';
const canonical = absolute(site, path);
const ogImage = absolute(site, '/og.jpg');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode(site, logo.src),
    websiteNode(site),
    webPageNode(site, path, title, description, page),
    breadcrumbNode(site, path),
    ...graph,
  ].filter(Boolean),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#262a6b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vet Valet logo beside a veterinarian greeting a dog at home" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
