---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
---
<Base title="Careers" description="Employment opportunities at Vet Valet, a women-owned mobile veterinary practice in MetroWest Boston.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Join us</span>
      <h1>Employment <em>opportunities</em></h1>
      <p class="lede">
        We’re not hiring at the moment, but we’re always happy to hear from interested candidates. Reach out to see if an
        opportunity may be available!
      </p>
    </div>
  </section>

  <CallToAction button="Contact us" title="Join our team!" text="Tell us a bit about yourself and your experience, and we’ll keep you in mind for future openings." />
</Base>
